# Database Configuration
# Pour PostgreSQL (recommandé en production)
DATABASE_URL=postgresql+asyncpg://mboa_user:mboa_password@localhost:5432/mboa_market

# Pour SQLite (développement local)
# DATABASE_URL=sqlite+aiosqlite:///./mboa_market.db

# Security
SECRET_KEY=mboa-market-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (séparés par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# SMS Configuration
SMS_PROVIDER=twilio
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./uploads

# Payment
PAYMENT_PROVIDER=mtn_momo
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_API_SECRET=your-payment-api-secret

# Environment
ENVIRONMENT=development

# AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
