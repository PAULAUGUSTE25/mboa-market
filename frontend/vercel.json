{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "https://mboa-market.onrender.com/api",
    "VITE_GEMINI_API_KEY": "AIzaSyDMveMdsMx0sCjOF6sdPNYuxzNe5r7ExYc",
    "VITE_OPENROUTER_API_KEY": "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"
  }
}
